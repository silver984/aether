{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "mingw",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "base_debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base_debug-verbose",
      "inherits": "base_debug",
      "cacheVariables": {
        "AETHER_VERBOSE_DEBUG": "ON"
      }
    },
    {
      "name": "base_release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base_release-with-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "mingw_debug",
      "inherits": [
        "mingw",
        "base_debug"
      ]
    },
    {
      "name": "mingw_debug-verbose",
      "inherits": [
        "mingw",
        "base_debug-verbose"
      ]
    },
    {
      "name": "mingw_release",
      "inherits": [
        "mingw",
        "base_release"
      ]
    },
    {
      "name": "mingw_release-with-debug",
      "inherits": [
        "mingw",
        "base_release-with-debug"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "base_debug",
      "configurePreset": "base_debug"
    },
    {
      "name": "base_debug-verbose",
      "configurePreset": "base_debug-verbose"
    },
    {
      "name": "base_release",
      "configurePreset": "base_release"
    },
    {
      "name": "base_release-with-debug",
      "configurePreset": "base_release-with-debug"
    },
    {
      "name": "mingw_debug",
      "configurePreset": "mingw_debug"
    },
    {
      "name": "mingw_debug-verbose",
      "configurePreset": "mingw_debug-verbose"
    },
    {
      "name": "mingw_release",
      "configurePreset": "mingw_release"
    },
    {
      "name": "mingw_release-with-debug",
      "configurePreset": "mingw_release-with-debug"
    }
  ]
}