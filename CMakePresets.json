{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "mingw",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-mingw",
      "inherits": ["mingw", "debug"]
    },
    {
      "name": "debug-verbose",
      "inherits": "debug",
      "cacheVariables": {
        "AETHER_VERBOSE_LOGS": "ON"
      }
    },
    {
      "name": "debug-verbose-mingw",
      "inherits": ["mingw", "debug-verbose"]
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-mingw",
      "inherits": ["mingw", "release"]
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-mingw",
      "configurePreset": "debug-mingw"
    },
    {
      "name": "debug-verbose",
      "configurePreset": "debug-verbose"
    },
    {
      "name": "debug-verbose-mingw",
      "configurePreset": "debug-verbose-mingw"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-mingw",
      "configurePreset": "release-mingw"
    }
  ]
}