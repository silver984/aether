{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-verbose",
      "inherits": "debug",
      "cacheVariables": {
        "AETHER_VERBOSE_DEBUG": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-with-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "msvc",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "gnu",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "msvc_debug",
      "inherits": [
        "msvc",
        "debug"
      ]
    },
    {
      "name": "msvc_debug-verbose",
      "inherits": [
        "msvc",
        "debug-verbose"
      ]
    },
    {
      "name": "msvc_release",
      "inherits": [
        "msvc",
        "release"
      ]
    },
    {
      "name": "msvc_release-with-debug",
      "inherits": [
        "msvc",
        "release-with-debug"
      ]
    },
    {
      "name": "gnu_debug",
      "inherits": [
        "gnu",
        "debug"
      ]
    },
    {
      "name": "gnu_debug-verbose",
      "inherits": [
        "gnu",
        "debug-verbose"
      ]
    },
    {
      "name": "gnu_release",
      "inherits": [
        "gnu",
        "release"
      ]
    },
    {
      "name": "gnu_release-with-debug",
      "inherits": [
        "gnu",
        "release-with-debug"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "msvc_debug",
      "configurePreset": "msvc_debug"
    },
    {
      "name": "msvc_debug-verbose",
      "configurePreset": "msvc_debug-verbose"
    },
    {
      "name": "msvc_release",
      "configurePreset": "msvc_release"
    },
    {
      "name": "msvc_release-with-debug",
      "configurePreset": "msvc_release-with-debug"
    },
    {
      "name": "gnu_debug",
      "configurePreset": "gnu_debug"
    },
    {
      "name": "gnu_debug-verbose",
      "configurePreset": "gnu_debug-verbose"
    },
    {
      "name": "gnu_release",
      "configurePreset": "gnu_release"
    },
    {
      "name": "gnu_release-with-debug",
      "configurePreset": "gnu_release-with-debug"
    }
  ]
}