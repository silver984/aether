{
  "version": 2,
  "configurePresets": [
    {
      "name": "aether",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "aether-debug",
      "inherits": "aether",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aether-debug-verbose",
      "inherits": "aether-debug",
      "cacheVariables": {
        "AETHER_VERBOSE_LOGS": "ON"
      }
    },
    {
      "name": "aether-release",
      "inherits": "aether",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "aether-debug",
      "configurePreset": "aether-debug"
    },
    {
      "name": "aether-debug-verbose",
      "configurePreset": "aether-debug-verbose"
    },
    {
      "name": "aether-release",
      "configurePreset": "aether-release"
    }
  ]
}